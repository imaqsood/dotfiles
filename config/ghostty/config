# =============================================================================
# Ghostty Configuration — matches WezTerm setup
# Optimized for: tmux user on macOS (Apple Silicon)
# Stack: tmux (multiplexer), Neovim (editor), Gruvbox Dark, Nerd Fonts
# Ghostty is the "dumb terminal" — tmux handles tabs/panes/sessions
# Docs: https://ghostty.org/docs/config/reference
# =============================================================================
#
# NOTE: Ghostty does NOT allow inline comments (# must be on its own line).
# Repeated keys (font-family, keybind, palette) append to a list.

# -----------------------------------------------------------------------------
# Font
# -----------------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-family-bold = JetBrainsMono Nerd Font
font-family-italic = JetBrainsMono Nerd Font
font-family-bold-italic = JetBrainsMono Nerd Font
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic

# Fallback fonts (appended; Ghostty tries them in order for missing glyphs)
font-family = Monaco Nerd Font
font-family = Symbols Nerd Font Mono
font-family = Apple Color Emoji

font-size = 15
# font-thicken intentionally off — matches WezTerm's native weight
# (Ghostty applies extra stroke thickening on macOS by default when true)
font-thicken = false

# Ligatures
font-feature = calt
font-feature = clig
font-feature = liga

# Line spacing (matches WezTerm line_height = 1.15)
adjust-cell-height = 15%

# -----------------------------------------------------------------------------
# Gruvbox Dark theme (exact WezTerm palette match)
# -----------------------------------------------------------------------------
background = #1d2021
foreground = #ebdbb2

cursor-color = #ebdbb2
cursor-text = #1d2021

selection-background = #504945
selection-foreground = #ebdbb2

# Standard ANSI palette (Gruvbox Dark)
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

# -----------------------------------------------------------------------------
# Window / Padding
# -----------------------------------------------------------------------------
window-decoration = true
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-padding-color = background
window-save-state = always
window-inherit-working-directory = true
window-inherit-font-size = true

# macOS window effects
background-opacity = 0.95
background-blur = 20
macos-option-as-alt = true

# Hide titlebar and traffic-light buttons (matches WezTerm window_decorations = "RESIZE")
# Window is still resizable by dragging edges; no top bar, no close/min/max buttons
macos-titlebar-style = hidden

# Start maximized
maximize = true

# -----------------------------------------------------------------------------
# Cursor
# -----------------------------------------------------------------------------
cursor-style = bar
cursor-style-blink = true

# -----------------------------------------------------------------------------
# Scrollback / Mouse
# -----------------------------------------------------------------------------
scrollback-limit = 10485760
mouse-scroll-multiplier = 3
mouse-hide-while-typing = true

# -----------------------------------------------------------------------------
# Shell
# -----------------------------------------------------------------------------
command = /opt/homebrew/bin/zsh --login
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# -----------------------------------------------------------------------------
# Behavior
# -----------------------------------------------------------------------------
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = true
window-new-tab-position = end
term = xterm-256color

# -----------------------------------------------------------------------------
# Keybindings
# Leader stays with tmux (Ctrl-A). Only terminal-level shortcuts here.
# -----------------------------------------------------------------------------

# Toggle fullscreen (Alt+Enter — matches WezTerm)
keybind = alt+enter=toggle_fullscreen

# Clear scrollback (Cmd+K — fixes garbled p10k after resize)
keybind = cmd+k=clear_screen

# Font size (matches WezTerm)
keybind = cmd+shift+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Copy / paste (standard macOS)
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# Reload config
keybind = cmd+shift+r=reload_config

# Debug inspector
keybind = cmd+shift+i=inspector:toggle

# =============================================================================
# End of config
# =============================================================================
