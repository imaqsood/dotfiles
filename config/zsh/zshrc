                                tmux new-window -t p4costy:3 -n ccm-frontend -c ~/dev/p4costy/ccm-frontend; \
                                tmux new-window -t p4costy:4 -n ccm-helm -c ~/dev/p4costy/ccm-helm; \
                                tmux new-window -t p4costy:5 -n ccm-infra -c ~/dev/p4costy/ccm-infra; \
